# day-0 step 4: minimal Ignition config for a new machine (Butane format, human-readable)
# Convert with butane to Ignition JSON and embed it in the install template
# Replace @@SSH_PUBKEY@@ with your own public key
variant: flatcar
version: 1.1.0
passwd:
  users:
    - name: core
      ssh_authorized_keys:
        - "@@SSH_PUBKEY@@"
storage:
  files:
    - path: /etc/hostname
      mode: 0644
      overwrite: true
      contents:
        inline: pool-node
    # kubelet sysext: staged now so the machine can become a K8s node later
    - path: /opt/extensions/kubernetes-v1.34.6-x86-64.raw
      mode: 0644
      contents:
        source: http://172.16.91.4:7173/kubernetes-v1.34.6-x86-64.raw
  links:
    - path: /etc/extensions/kubernetes.raw
      target: /opt/extensions/kubernetes-v1.34.6-x86-64.raw
      hard: false
