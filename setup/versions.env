# 工作坊版本鎖定（唯一真相源）— 2026-08-21 驗證於 Ubuntu 24.04 / Docker 29.1.3
# 注意：kind v0.32.0 於本驗收環境（PVE 上的 Ubuntu 24.04 VM + Docker 29.1.3）實測
# 無法啟動控制平面（kubelet 未建立任何 static pod，根因未查明）；v0.30.0 同環境一次通過。
# 保守起見全面鎖定 v0.30.0。
KIND_VERSION=v0.30.0
# 注意：一律用 tag 引用 —— docker save/kind load 對 digest 引用會失效（層重排後 digest 不符）
KINDEST_NODE_IMAGE="kindest/node:v1.34.0"
# 供驗證的原始 digest：sha256:7416a61b42b1662ca6ca89f02028ac133a309a2a30ba309614e8ec94d976dc5a
CAPI_VERSION=v1.13.4
CAPD_VERSION=v1.14.0
CERT_MANAGER_VERSION=v1.20.3
CLUSTERCTL_VERSION=v1.13.4
KUBECTL_VERSION=v1.34.1
K8S_VERSION=v1.34.0          # child cluster 版本（與 node image 一致）
KRO_VERSION=0.9.3
KRO_IMAGE="registry.k8s.io/kro/kro:v0.9.3"
# 映像檔版本必須對齊 provider manifests：core/bootstrap/control-plane 是 ${CAPI_VERSION}、
# CAPD 是 ${CAPD_VERSION}（clusterctl 各自解析）
CAPI_IMAGES=(
  "registry.k8s.io/cluster-api/cluster-api-controller:v1.13.4"
  "registry.k8s.io/cluster-api/kubeadm-bootstrap-controller:v1.13.4"
  "registry.k8s.io/cluster-api/kubeadm-control-plane-controller:v1.13.4"
  "gcr.io/k8s-staging-cluster-api/capd-manager:v1.14.0"
  "quay.io/jetstack/cert-manager-controller:v1.20.3"
  "quay.io/jetstack/cert-manager-cainjector:v1.20.3"
  "quay.io/jetstack/cert-manager-webhook:v1.20.3"
)
